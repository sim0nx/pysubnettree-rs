from collections.abc import Iterable, Iterator, Mapping
from os import PathLike
from typing import Any, Final, Generic, TypedDict, TypeVar, final, overload

from pysubnettree_rs._types import Key, Network

_T = TypeVar('_T')
_D = TypeVar('_D')
_N = TypeVar('_N', bound=Network)

FORMAT_VERSION: Final[int]
_DEBUG_BUILD: Final[bool]

class Stats(TypedDict):
    ipv4_networks: int
    ipv6_networks: int
    distinct_values: int
    memory_usage: int

@final
class SubnetTreeRS(Generic[_T]):
    # Without a value type any supported value is accepted and lookups return Any.
    @overload
    def __new__(cls, value_type: None = None) -> SubnetTreeRS[Any]: ...
    @overload
    def __new__(cls, value_type: type[_T]) -> SubnetTreeRS[_T]: ...
    @property
    def value_type(self) -> type[_T] | None: ...
    def insert(self, network: Network, value: _T | None = None) -> bool: ...
    def insert_many(self, items: Mapping[_N, _T | None] | Iterable[tuple[Network, _T | None]]) -> int: ...
    def __setitem__(self, network: Network, value: _T | None) -> None: ...
    def remove(self, network: Network) -> _T | None: ...
    def __delitem__(self, network: Network) -> None: ...
    def __getitem__(self, key: Key) -> _T | None: ...
    @overload
    def get(self, key: Key) -> _T | None: ...
    @overload
    def get(self, key: Key, default: _D) -> _T | _D | None: ...
    def lookup(self, key: Key) -> tuple[str, _T | None] | None: ...
    def lookup_all(self, key: Key) -> list[tuple[str, _T | None]]: ...
    def __contains__(self, key: object) -> bool: ...
    def has_network(self, network: Network) -> bool: ...
    @overload
    def get_exact(self, network: Network) -> _T | None: ...
    @overload
    def get_exact(self, network: Network, default: _D) -> _T | _D | None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def items(self) -> list[tuple[str, _T | None]]: ...
    def clear(self) -> None: ...
    def compile(self) -> None: ...
    def memory_usage(self) -> int: ...
    def stats(self) -> Stats: ...
    def to_bytes(self) -> bytes: ...
    @overload
    @classmethod
    def from_bytes(cls, data: bytes, value_type: None = None, types: Iterable[type] = ()) -> SubnetTreeRS[Any]: ...
    @overload
    @classmethod
    def from_bytes(cls, data: bytes, value_type: type[_T], types: Iterable[type] = ()) -> SubnetTreeRS[_T]: ...
    def dump(self, path: str | PathLike[str]) -> None: ...
    @overload
    @classmethod
    def load(cls, path: str | PathLike[str], value_type: None = None, types: Iterable[type] = ()) -> SubnetTreeRS[Any]: ...
    @overload
    @classmethod
    def load(cls, path: str | PathLike[str], value_type: type[_T], types: Iterable[type] = ()) -> SubnetTreeRS[_T]: ...
    def __reduce__(self) -> tuple[Any, tuple[bytes, type[_T] | None, tuple[type, ...]]]: ...
